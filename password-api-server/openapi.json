{
  "openapi": "3.0.3",
  "info": {
    "title": "Password API",
    "version": "1.0.0",
    "description": "Retrieve stored credentials by URL or list all."
  },
  "servers": [
    { "url": "http://localhost:3000" }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "List all passwords or filter by URL",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "URL to filter passwords for (e.g. localhost:8080/phpmyadmin)"
          }
        ],
        "responses": {
          "200": {
            "description": "Array of credential objects",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "url": { "type": "string" },
                      "username": { "type": "string" },
                      "password": { "type": "string" },
                      "message": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
